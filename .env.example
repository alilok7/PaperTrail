# Copy this file to .env and fill in your values. .env is gitignored — never commit it.

# === AWS Bedrock (LLM) ===
AWS_REGION=us-east-1
# Auth — use EITHER a Bedrock API key (bearer token, simplest) ...
AWS_BEARER_TOKEN_BEDROCK=
# ... OR a traditional IAM access-key pair:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Cross-region inference-profile ID (copy the exact one from the model's detail page).
# Recommended: us.anthropic.claude-sonnet-4-6   |   Max quality (pricier): us.anthropic.claude-opus-4-8
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# === Voyage AI (embeddings) ===
VOYAGE_API_KEY=

# === LangSmith (observability — required) ===
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=paper-trail
